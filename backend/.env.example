# Copy this file to backend/.env and fill in real values. backend/.env is gitignored
# (see .gitignore's `backend/**/.env` pattern) -- never commit real keys.
#
# backend/api/main.py loads backend/.env automatically on startup, regardless of which
# directory you run uvicorn from. This is the one canonical env file for the whole
# backend -- every module (signal_intake, scoring, diligence_memo, api) reads from the
# process environment, which this file populates.

# ---- Required ----
OPENAI_API_KEY=
TAVILY_API_KEY=

# ---- Optional: cold-outreach sending ----
# Without these, outbound_scan.py's Activate emails dry-run log to
# backend/signal_intake/activation_outbox.jsonl instead of actually sending.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_SMTP_PASSWORD=

# ---- Optional: enrichment providers ----
# Each degrades gracefully (skipped, not an error) if left unset.
PRODUCT_HUNT_API_TOKEN=
PEOPLE_DATA_LABS_API_KEY=

# ---- Optional: links embedded in outbound emails ----
# Sensible localhost defaults are used if unset -- only needed for a real deployment.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ---- Optional: outbound scan pool size ----
# Defaults shown below match the code's own defaults if these are left unset.
OUTBOUND_GITHUB_LIMIT=50
OUTBOUND_HN_LIMIT=30
OUTBOUND_ARXIV_LIMIT=30
OUTBOUND_PRODUCT_HUNT_LIMIT=20
